# ソラ先生 TikTok自動生成の設定例。これを .env にコピーして値を入れる。
# 注意: .env は絶対にGitに入れない（.gitignore 済み）。キーはチャットに貼らない。

# まずは安全側（投稿せず動画だけ生成）。実投稿するときに 0 にする。
DRY_RUN=1

# 誘導先（bioに置くURL。TikTokは動画内・キャプションにリンクを貼れない）。
APP_URL=https://sora-vocal-ai.duckdns.org

# 1日の投稿上限（docs/34 は週4本＝1日1本想定）。
MAX_POSTS_PER_DAY=1

# 初期は自分のみ公開で検証 → 問題なければ PUBLIC_TO_EVERYONE に。
TIKTOK_PRIVACY=SELF_ONLY

# --- 台本の口語リライト（任意。無くてもテンプレで動く）---
ANTHROPIC_API_KEY=
# TIKTOK_LLM_MODEL=claude-sonnet-4-6

# --- ナレーション音声（任意。無ければ無音で尺だけ確保）---
# ElevenLabs で自分の声をクローン → voice_id を貼る（docs/34 コスト試算: 月$11程度）。
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- 実写B-roll（紙芝居脱却の核。無ければ背景にフォールバック）---
# Pexels で無料登録 → APIキー発行（無料・商用OK・クレジット不要）。
# https://www.pexels.com/api/  ネタに合う縦型の実写素材を自動取得し各カットに敷く（ffmpeg必須）。
PEXELS_API_KEY=
# PIXABAY_API_KEY=   ← 任意。B-rollの幅を増やしたい場合（未使用でもOK）

# --- トレンド検出（任意。無ければ trends_seed.json / 既定にフォールバック）---
# TikTok Research API トークン（要申請）。伸びてる尺・音源に寄せる。
TIKTOK_RESEARCH_TOKEN=

# --- 投稿（任意。無ければ生成のみ）---
# Content Posting API のユーザーアクセストークン（OAuthで取得・要承認アプリ）。
TIKTOK_ACCESS_TOKEN=

# --- 投稿前チェック通知（任意）---
# 1 にすると動画を out/pending/ に置き、LINEまたはDiscordに通知してから止まる。
# 承認は別途 python approve.py を実行。0(既定)なら生成後に直接投稿。
NOTIFY_BEFORE_POST=1

# LINE Messaging API（公式LINEアカウント経由。無料枠200通/月）
# 取得方法: https://developers.line.biz/ja/ でMessaging APIチャンネルを作成
# 1) チャンネルアクセストークン（長期）を発行して下に貼る
# 2) ボットを自分のLINEで友だち追加（QRコード）
# ユーザーIDは不要（未設定なら broadcast=友だち全員=自分宛 で送信）。
TIKTOK_LINE_CHANNEL_TOKEN=
# TIKTOK_LINE_USER_ID=   ← 特定ユーザーにだけ送りたい場合のみ設定（Uで始まる文字列）

# Discord Webhook URL（LINEの代わり、またはフォールバック）。
TIKTOK_DISCORD_WEBHOOK_URL=

# --- 描画の補助（任意）---
# 日本語テロップ用フォント（未指定なら NotoSansCJK 等を自動探索）。
# TIKTOK_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
