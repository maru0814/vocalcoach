# ソラ先生 SNS自動投稿の設定例。これを .env にコピーして値を入れる。
# 注意: .env は絶対にGitに入れない（.gitignore 済み）。キーはチャットに貼らない。

# まずは安全側（投稿せず本文だけ確認）。実投稿するときに 0 にする。
DRY_RUN=1

# 承認フロー: 1=生成後にLINEで承認を取ってから投稿（既定）/0=従来どおり即投稿。
# 1 のときは generate_and_post.py は投稿せず、承認キュー＋LINE通知だけ行う。
APPROVAL_MODE=1

# 誘導先（本番URL）。独自ドメインにしたら変更。
APP_URL=https://sora-vocal-ai.duckdns.org

# --- LINE承認（投稿前の確認用）---
# LINE Developers で Messaging API チャネルを作成して取得する。
#   1) https://developers.line.biz/ でプロバイダ→Messaging APIチャネル作成
#   2) 「チャネルアクセストークン（長期）」を発行 → 下に貼る
#   3) 「チャネルシークレット」を下に貼る（Webhook署名検証に使用）
#   4) Webhook URL に https://<DOMAIN>/sns/line/webhook を設定し「Webhookの利用」をON
#   5) 自分のLINEでそのチャネル（公式アカウント）を友だち追加 → 返ってくる userId を
#      LINE_OPERATOR_USER_ID に設定（webhook.py が follow 時に教えてくれる）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OPERATOR_USER_ID=
# Webhook常駐サーバのポート（Caddyからここへreverse_proxyする）
WEBHOOK_PORT=8088
# 公開URLのベース（Caddyで /sns/* をこのサーバへ通している公開ドメイン）。
# 設定すると LINE承認メッセージに投稿画像のプレビューを実物表示する
# （webhookの GET /sns/img/{name} が配信。未設定ならテキストの添付注記のみ）。
SNS_PUBLIC_BASE_URL=https://sora-vocal-ai.duckdns.org

# --- コスト/予算ガード（docs/29）---
# URL投稿は $0.20/件 と高くリーチも落ちるため既定OFF。リンクはプロフィール固定で誘導。
# 1 にすると自己リプにURLを付与（課金注意）。
POST_LINK=0
# 1日の投稿上限（朝+昼+夜の3投稿運用。cronも朝・昼・夜の3枠で叩く。2026-08-01〜）
# 注意: 本番は docker-compose.prod.yml の environment が .env より優先される。
MAX_POSTS_PER_DAY=3
# 月間の概算コスト上限（USD）。超えたら投稿停止。月2000円なら12前後が目安。
MONTHLY_COST_CAP_USD=12

# あれば文面をAI生成（無くてもテンプレで動く）。プロダクトと同じキーでOK。
# 画像のAI背景生成にも同じキーを使う（無ければPillowグラデにフォールバック）。
GEMINI_API_KEY=
# SNS_LLM_MODEL=gemini-flash-lite-latest

# --- 投稿画像（縦4:5のブランド画像を全投稿に添付）---
# 総スイッチ。0で従来どおり画像なし投稿。既定ON。
SNS_IMAGE=1
# AI背景を試す（既定ON）。0でPillowグラデ固定。キー未設定なら自動でグラデ。
SNS_IMAGE_AI=1
# 画像モデル。'imagen'を含めばImagen(predict)、それ以外はgemini-*-image(generateContent)。
# 既定は imagen-4.0-fast-generate-001（安価・高速）。失敗・未許可なら自動でグラデ。
#   例) imagen-4.0-generate-001（標準画質） / gemini-2.5-flash-image（Nano Banana）
# SNS_IMAGE_MODEL=imagen-4.0-fast-generate-001
# 日本語フォント（丸ゴシック推奨）。Dockerは Noto CJK を同梱しENVで指定済み。
# ローカル(mac)は未設定でもヒラギノ丸ゴを自動検出。
# SNS_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# X(旧Twitter) 投稿用キー。developer.twitter.com でアプリ作成 → OAuth1.0a のキーを発行。
#   - App permissions は「Read and write」にする
#   - 必要なのは API Key/Secret（Consumer）と Access Token/Secret（自分のアカウント）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Threads 自動投稿（docs/63/64。投稿APIは無料）---
# 1 にすると、LINEの [✅承認して投稿] 1回で X と Threads の両方に投稿する
# （承認操作は増えない。Threads失敗はX投稿を止めない）。0 なら完全に従来どおり。
THREADS_ENABLED=0
# 取得手順（自分のアカウントに投稿するだけならアプリ審査は不要）:
#   1) https://developers.facebook.com/ でアプリ作成 → ユースケース「Threads API」を追加
#   2) 自分のThreadsアカウントをテスターとして連携（Threadsアプリ側で承認）
#   3) 長期アクセストークン（約60日）と ThreadsユーザーID を発行して下に貼る
# トークンは投稿時に自動リフレッシュされ {SNS_DATA_DIR}/threads_token.json に保存される
# （.env の値は初回シード。45日経過で自動延命するため手動再発行は不要）。
# 画像添付には SNS_PUBLIC_BASE_URL（上記）が必要。未設定ならテキストのみ投稿。
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- Xフォロー候補（docs/58/59。readは従量API・フォロー実行は常に人間の手動）---
# フォローの自動実行は実装として存在しない（バン安全性の不変条件。返信文の生成も廃止）。
# 1日にLINEへ提示するフォロー候補数の上限。公式な「安全な数」は存在しないため、
# 新規/小規模アカウントの経験則（フォロー速度スパイクを避ける）に基づく目安。
# 最初の1〜2週間は10〜15、様子を見て段階的に25程度まで。1日で一気に消化せず時間を分けて。
MAX_FOLLOWS_PER_DAY=15
# 狙うフォロワー数レンジ（伸び悩み・上達意欲層）。取得できない候補には適用しない。
LEAD_FOLLOWERS_MIN=30
LEAD_FOLLOWERS_MAX=3000
# 相互フォロー狙いアカウントの除外ワード（カンマ区切り）
LEAD_EXCLUDE_KEYWORDS=相互,フォロバ100,相互フォロー
# read課金の1日予算（概算USD）。超えたら探索を止める。post read $0.005 / user read $0.010 / owned $0.001
LEAD_DAILY_READ_BUDGET_USD=0.60
# 1回の実行で回す検索クエリ数。優先3テーマ（歌上達/ミックスボイス/カラオケ上達）は
# 毎回必ず含み、残り枠を他クエリで日替わりローテーション（既定4=優先3+ローテ1）。
LEAD_QUERIES_PER_RUN=4
