{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/.bin/next",
        "dev",
        "-p",
        "3000"
      ],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "backend",
      "runtimeExecutable": "./.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000,
      "cwd": "backend"
    }
  ]
}