# 本番デプロイ用の環境変数テンプレート。
# これを `docker/.env` にコピーして値を埋めてください。
#   cp .env.prod.example .env

# 公開ドメイン（事前にこのVPSのIPへAレコードでDNSを向けておく）
DOMAIN=example.com

# JWT署名鍵（必ずランダムな長い文字列に変更。例: openssl rand -hex 32）
JWT_SECRET=CHANGE_ME_to_a_long_random_secret

# 原曲のYouTube取得を使うか（規約/ブロックのリスクあり。既定 false ＝録音単体FB）
ENABLE_YOUTUBE_REFERENCE=false

# ソラ先生の自然言語チャット応答（Google Gemini）。
# 空なら自動でルールベース応答にフォールバック（音声解析・採点は常に無料のルールベース）。
# 取得: https://aistudio.google.com/apikey （Flash-Lite は無料枠あり＝実質0円運用も可）
GEMINI_API_KEY=
# 最安クラスの Flash-Lite が既定。品質を上げたいときだけ変更（例: gemini-flash-latest）
LLM_MODEL=gemini-flash-lite-latest

# uvicorn ワーカ数（小さいVPSは1〜2推奨。解析はCPU負荷が高い）
WEB_CONCURRENCY=2
