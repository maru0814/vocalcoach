# 本番デプロイ用の環境変数テンプレート。
# これを `docker/.env` にコピーして値を埋めてください。
#   cp .env.prod.example .env

# 公開ドメイン（事前にこのVPSのIPへAレコードでDNSを向けておく）
DOMAIN=example.com

# JWT署名鍵（必ずランダムな長い文字列に変更。例: openssl rand -hex 32）
JWT_SECRET=CHANGE_ME_to_a_long_random_secret

# 原曲のYouTube取得を使うか（規約/ブロックのリスクあり。既定 false ＝録音単体FB）
ENABLE_YOUTUBE_REFERENCE=false

# ソラ先生の自然言語チャット応答（Google Gemini）。
# 空なら自動でルールベース応答にフォールバック（音声解析・採点は常に無料のルールベース）。
# 取得: https://aistudio.google.com/apikey （Flash-Lite は無料枠あり＝実質0円運用も可）
GEMINI_API_KEY=
# --- モデルID（すべて任意。空 or 未設定ならコード側の既定を使う）---
# ⚠️ "-latest" エイリアスは指定しないこと。Google 側で世代が切り替わると呼び出し
#    パラメータの互換性ごと壊れる（実際にテキスト会話が全滅した。docs/91 / docs/92）。
# ここは「緊急時の載せ替え口」。モデルが 404/400 で死んだら、該当行に生きている
# モデルIDを書いて `docker compose up -d backend` するだけで復旧できる（再デプロイ不要）。
# 指定する前に必ず実APIで疎通確認すること（models.list に載っていても死んでいる場合がある）。
# LLM_MODEL=
# LLM_CHAT_MODEL=
# LLM_AUDIO_MODEL=
# LLM_ANALYSIS_MODEL=
# 音声入力を Gemini 3 系へ載せ替える時だけ触る（3系は thinking を切れない。docs/92 §2-3）
# LLM_AUDIO_THINKING_BUDGET=
# LLM_AUDIO_MAX_TOKENS=

# uvicorn ワーカ数（小さいVPSは1〜2推奨。解析はCPU負荷が高い）
WEB_CONCURRENCY=2

# Cloudflare Web Analytics のビーコントークン（無料・DNS変更不要のJS計測）。
# 取得: Cloudflareダッシュボード → Web Analytics → サイト追加 → トークン。
# 公開値（HTMLに埋まる）なので秘密ではない。空なら計測タグは出ない。
CF_BEACON_TOKEN=

# --- Stripe課金（docs/31）。空 or BILLING_ENABLED=0 なら課金機能は無効（緊急停止スイッチ）---
# 取得は本番モードのStripeダッシュボードから（テスト鍵 sk_test_/price_test_ は本番で使わない）:
#   STRIPE_SECRET_KEY      … Developers → API keys の sk_live_...
#   STRIPE_PRICE_ID_PREMIUM… Products でプレミアム商品(¥500/月)を作成 → price_...
#   STRIPE_WEBHOOK_SECRET  … Developers → Webhooks でエンドポイント1つ作成し4イベント購読 → whsec_...
#     エンドポイントURL: https://<DOMAIN>/api/v1/billing/webhook
#     購読イベント: customer.subscription.created/updated/deleted, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_WEBHOOK_SECRET=
# 課金機能の本番ON/OFF（緊急停止スイッチ）。1=有効 / 0 or 未設定=無効。
BILLING_ENABLED=0

# --- PWA プッシュ通知（練習リマインド。docs/73〜75）---
# VAPID鍵ペア。未設定でも購読保存・アプリは動くが、配信と購読作成はスキップされる。
# 生成（このリポジトリの scripts/ops/gen_vapid_keys.py を1回実行して出力を貼る）:
#   python3 scripts/ops/gen_vapid_keys.py
# VAPID_PUBLIC_KEY はブラウザの購読にも使うため frontend ビルド引数
# NEXT_PUBLIC_VAPID_PUBLIC_KEY（compose が VAPID_PUBLIC_KEY から自動で渡す）にも反映される。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知の連絡先（VAPID subject）。実在の mailto: にする。
VAPID_SUBJECT=mailto:admin@example.com
