# 同一ドメインで front と back を配信（→ CORS/Cookie の悩みゼロ）
# /api/* と /healthz は backend、それ以外は frontend へ。
# {$DOMAIN} は compose の environment から注入。HTTPS は Caddy が自動取得。

{$DOMAIN} {
	encode gzip

	# アクセスログ（プロフィールリンク→LP到達数の週次計測用）。
	# JSON形式で永続volume(/data)に記録。ローテーションで最大約50MiBに頭打ち。
	# ページ閲覧→/api/voice-type/stats→診断POST までファネル全体を1本のログで追える。
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format json
	}

	# バックエンドAPI
	@api path /api/* /healthz
	handle @api {
		reverse_proxy backend:8000
	}

	# SNS投稿のLINE承認Webhook（独立サービス）。
	# LINE Developers の Webhook URL に https://{$DOMAIN}/sns/line/webhook を設定。
	@sns path /sns/*
	handle @sns {
		reverse_proxy sns:8088
	}

	# TenYen（別リポジトリ /opt/sns-pipeline）のLINE承認Webhook。
	# コンテナは外部ネットワーク edge 上（docker network create edge が前提）。
	# TenYen側のLINEチャネルの Webhook URL は https://{$DOMAIN}/tenyen/line/webhook。
	@tenyen path /tenyen/*
	handle @tenyen {
		reverse_proxy tenyen-sns:8090
	}

	# フロントエンド（Next.js standalone）
	handle {
		reverse_proxy frontend:3000
	}
}
