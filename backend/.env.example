DATABASE_URL=
DB_HOST=db
DB_PORT=3306
DB_NAME=claude_md
DB_USER=app
DB_PASSWORD=app_password

JWT_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=1440
COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

UPLOADS_DIR=uploads

# --- ソラ先生の自然言語チャット応答（Google Gemini）---
# 設定すると、テキスト質問への返答が ChatGPT のような自然言語になる。
# 未設定なら自動でルールベース応答にフォールバック（音声解析・採点は常にルールベース）。
# 取得: https://aistudio.google.com/apikey （Flash-Lite は無料枠あり）
GEMINI_API_KEY=
# 最安クラスの Flash-Lite が既定。上書きしたいときだけ設定（例: gemini-flash-latest）
LLM_MODEL=gemini-flash-lite-latest
